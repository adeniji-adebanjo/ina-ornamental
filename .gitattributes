# Files that run or are read on Linux (server, GitHub runners) must keep LF
# line endings even when checked out on Windows with core.autocrlf=true —
# a CRLF shell script fails with "$'\r': command not found".
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.nvmrc          text eol=lf
