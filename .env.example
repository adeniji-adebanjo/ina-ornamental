# Copy to .env.local (dev) or .env.production (server) and fill in.
# Never commit real values.

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://inaornamentalfish.com
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Analytics stays off when
# unset, and never loads on /admin, /login or private /orders links.
NEXT_PUBLIC_GA_ID=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — keep it out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (order confirmations, shipment updates) ────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
# Comma-separated recipients for new-order notifications.
ADMIN_EMAIL=

# ── WordPress (blog + media library) ─────────────────────────────────────────
WP_API_URL=
WP_USERNAME=
WP_APP_PASSWORD=
NEXT_PUBLIC_WP_API_URL=

# ── Instagram feed ───────────────────────────────────────────────────────────
BEHOLD_FEED_URL=
# Shared secret for the scheduled POST /api/instagram/sync (x-cron-secret header).
CRON_SECRET=
